UPSTREAM_BASE_URL=https://chatjimmy.ai
UPSTREAM_API_KEY=

# Toggle passthrough for tool-related request fields.
EXPERIMENTAL_TOOL_USAGE=false

# Upstream request safety/performance controls.
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_MAX_RETRIES=2
UPSTREAM_PREFILL_TOKEN_LIMIT=6064
UPSTREAM_REQUEST_BYTE_LIMIT=1200000

# Local wrapper server config.
HOST=127.0.0.1
PORT=8787
DEFAULT_STREAM=false

# Wrapper access key required from clients (Bearer token).
WRAPPER_API_KEY=replace-with-strong-key

# Maximum accepted request body size in MB.
BODY_LIMIT_MB=25
